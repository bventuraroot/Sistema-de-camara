# ==========================================
# Configuración del Sistema de Cámaras
# ==========================================

# Configuración de la cámara Tuya
TUYA_REGION=eu-central
TUYA_EMAIL=tu_email@example.com
TUYA_DEVICE_ID=tu_device_id_aqui

# Configuración del stream RTSP (stream HD con fallback automático)
RTSP_URL=rtsp://localhost:8554/Cámara_de_nubes/hd
RTSP_PORT=8554

# Configuración de detección inteligente
MOTION_THRESHOLD=4000
CONFIDENCE_THRESHOLD=0.45
ALERT_COOLDOWN=5
AI_MOTION_ONLY=true

# Ubicación y configuración de grabación continua 24/7
RECORDINGS_DIR=./recordings
CONTINUOUS_RECORDING=false
SEGMENT_MINUTES=5
MAX_RECORDING_DAYS=30

# Configuración del servidor web (Puerto 5001)
WEB_PORT=5001
DEBUG=false
